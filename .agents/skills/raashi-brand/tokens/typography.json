{
  "fontFamilies": ["Inter", "Plus Jakarta Sans", "Manrope"],
  "fontWeights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "typeScale": {
    "heroDisplay": { "fontSize": "56px", "lineHeight": "1.1", "letterSpacing": "-0.03em" },
    "h1": { "fontSize": "40px", "lineHeight": "1.2", "letterSpacing": "-0.02em" },
    "h2": { "fontSize": "32px", "lineHeight": "1.25", "letterSpacing": "-0.01em" },
    "h3": { "fontSize": "24px", "lineHeight": "1.3", "letterSpacing": "0em" },
    "bodyLarge": { "fontSize": "18px", "lineHeight": "1.5", "letterSpacing": "0em" },
    "bodyBase": { "fontSize": "16px", "lineHeight": "1.5", "letterSpacing": "0em" },
    "bodySmall": { "fontSize": "14px", "lineHeight": "1.4", "letterSpacing": "0em" },
    "caption": { "fontSize": "12px", "lineHeight": "1.3", "letterSpacing": "0.02em" }
  }
}
