# App
APP_NAME="API Testing Platform"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=api_testing

# JWT Auth
SECRET_KEY=change-me-to-at-least-32-chars-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenRouter (Cloud AI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# NVIDIA NIM (Cloud AI)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# Local AI (Ollama / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# AI Orchestrator Mode
AGENTIC_MODE=false
AI_PRIMARY_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=nim

# RAG / Vector Store
VECTOR_DIR=./data/chroma
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Target Safety & Limits
OWNED_HOST_ALLOWLIST=
ONLINE_MAX_RPS=2.0
ONLINE_MAX_CONCURRENCY=3

# Secrets Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=

# Reports
REPORTS_DIR=./data/reports

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

