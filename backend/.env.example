# App
APP_NAME=API Testing Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=api_testing

# JWT Auth (generate a secure random string for production)
SECRET_KEY=your-super-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_REFRESH_TOKENS=5

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=API Testing Platform

# NVIDIA NIM
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# AI Orchestrator
AI_PRIMARY_PROVIDER=nim
AI_FALLBACK_PROVIDER=openrouter
AI_MAX_RETRIES_PER_PROVIDER=2
AI_REQUEST_TIMEOUT=60.0
AI_MAX_OUTPUT_TOKENS=4096
PROVIDER_CIRCUIT_FAILURES=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
GENERATION_CONCURRENCY=3
UNIT_DEADLINE_SECONDS=120
RESUME_SESSIONS_ON_STARTUP=true
TRIAGE_MAX_TOKENS_PER_SESSION=12000
MIN_GENERATION_COVERAGE=0.8
MAX_TESTS_PER_CALL=20

# Test Execution
DEFAULT_CONCURRENCY=10
DEFAULT_REQUEST_TIMEOUT=30.0
DEFAULT_MAX_RETRIES=1
MAX_RESPONSE_BODY_BYTES=51200

# Rate Limiting (self-protection)
RATE_LIMIT_RPS=

# Reports
REPORTS_DIR=/data/reports
REPORT_DISCLAIMER="AI-assisted testing, not a certified security audit"

# Secrets Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

