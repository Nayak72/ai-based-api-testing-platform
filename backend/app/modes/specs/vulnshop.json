        "tags": [
          "users"
        ],
        "summary": "Update user (FLAW: BOPLA mass assignment)",
        "description": "FLAW (API3 \u2014 BOPLA): Accepts 'role' field in body \u2014 allows privilege escalation.\nA regular user can promote themselves to admin.",
        "operationId": "update_user_users__user_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
