# ------------------------------------------------------------------------------
# Environments & Secrets (CRITICAL: Do NOT commit secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
demo_targets/**/.env
!*.env.example

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# Python packaging & distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python testing & linting caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py,cover
pip-log.txt
pip-delete-this-directory.txt

